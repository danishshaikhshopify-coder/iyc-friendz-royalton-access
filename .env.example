# Royalton Access — environment variables
# Copy to .env.local for local development. Never commit the real .env file.
#
# For local dev with no live Shopify/Turso/email credentials, the defaults
# below (TURSO_DATABASE_URL=file:./dev.db, EMAIL_PROVIDER=none) let the app
# run and the test suite pass without any external service.

# ── Shopify store + Admin API ──────────────────────────────────────────────
# The *.myshopify.com domain for the store (not the custom domain).
SHOPIFY_SHOP_DOMAIN=inyourcitycorp.myshopify.com

# The customer-facing storefront domain, used to build/validate App Proxy
# request origins and any links shown to customers.
SHOPIFY_STOREFRONT_DOMAIN=inyourcitycorp.com

# Admin API version this service was built/tested against.
SHOPIFY_ADMIN_API_VERSION=2026-01

# Admin API access token for a Dev-Dashboard custom app with, at minimum,
# the read_orders scope. No write scopes are required by this service.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Webhook signing secret (from the Shopify app's API credentials page) used
# to verify the X-Shopify-Hmac-Sha256 header on incoming webhooks.
SHOPIFY_WEBHOOK_SIGNING_SECRET=

# App Proxy signing secret (the same app's API secret key) used to verify
# the `signature` query parameter Shopify appends to App Proxy requests.
SHOPIFY_APP_PROXY_SIGNING_SECRET=

# Product handle for the Event Pass. Orders are only eligible when every
# line item matches this product.
EVENT_PASS_PRODUCT_HANDLE=iyc-friendz-weekend-pass

# App Proxy subpath this app is registered under (Shopify Admin > Apps >
# Develop apps > [app] > App proxy > Subpath prefix + subpath). Must match
# exactly what's configured there, including the leading slash.
SHOPIFY_APP_PROXY_SUBPATH=/apps/royalton-access

# ── Royalton booking URL ───────────────────────────────────────────────────
# The real, private Royalton booking URL. Deliberately left blank here — do
# NOT invent or paste a placeholder. While unset, the access page degrades
# gracefully (no booking button is rendered, eligible or not) and no email
# is sent with a missing-URL state. Set this only once the client supplies
# the real URL.
ROYALTON_BOOKING_URL=

# ── Access tokens ───────────────────────────────────────────────────────────
# 32+ random bytes (base64 or hex) used to derive/verify customer access
# tokens. Generate with: openssl rand -base64 32
ACCESS_TOKEN_SIGNING_SECRET=

# ── Database (Turso / libSQL) ──────────────────────────────────────────────
# For local dev, leave as the local file URL below and omit the auth token.
TURSO_DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# ── Email delivery ──────────────────────────────────────────────────────────
# Implemented: "klaviyo" | "omnisend" | "none". "smtp" is documented as a
# future option but is NOT implemented — setting it throws at send time
# rather than silently dropping the email (see src/lib/email.ts).
# "none" logs the would-be email to the console instead of sending — use
# this for local development until a real provider is wired up and
# confirmed capable of sending a transactional, per-customer link (see the
# Task 17 report's notes on existing marketing-tool limitations).
EMAIL_PROVIDER=none
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_TRANSACTIONAL_FLOW_ID=
OMNISEND_API_KEY=
EMAIL_FROM_ADDRESS=bookings@inyourcitycorp.com

# ── Rate limiting (App Proxy access route) ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# ── Business policy ────────────────────────────────────────────────────────
# How a PARTIALLY refunded order is treated. CONFIRMED client decision
# (Task 17): a partial refund revokes access, same as a full refund — leave
# this at "deny". The "allow" value is kept only as a config knob in case
# that policy is ever explicitly reversed by the client in writing; do not
# set it to "allow" based on an assumption.
PARTIAL_REFUND_POLICY=deny
